# =============================================================
# AnyWare Sales AI - 環境変数
# .env.local にコピーして値を設定してください（.env.local はコミットしない）
# =============================================================

# --- アプリ ---
# 公開URL（Vercel本番: https://xxx.vercel.app / ローカル: http://localhost:3000）
APP_URL=http://localhost:3000

# 外部API（GビズINFO / Google / Claude）の接続モード
#   live : 実APIを利用（APIキー必須）
#   mock : モックデータを利用（APIキー不要・開発/UI確認用）
# 未設定時: development では mock、production では live
DATA_MODE=mock

# 認証モード
#   supabase : Supabase Auth（本番は必ずこちら）
#   disabled : 認証をスキップ（development 限定。production では無視されます）
AUTH_MODE=supabase

# --- Supabase ---
# Supabase Dashboard > Project Settings > API から取得
# ローカル(supabase start)の場合は `supabase status` の値
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側（ジョブ処理・Cron）でのみ使用。クライアントに絶対に露出させない
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude ---
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=
# 使用モデル（コードに直書きしない）
ANTHROPIC_MODEL=claude-opus-5
# 1リクエストの最大出力トークン
ANTHROPIC_MAX_OUTPUT_TOKENS=8000
# AI分析の効率設定 low / medium / high
ANTHROPIC_EFFORT=medium

# --- GビズINFO ---
# https://info.gbiz.go.jp/ で API利用申請 → 発行されたトークン
GBIZ_API_KEY=

# --- Google Places API（任意。公式サイト探索の補助） ---
# Google Cloud Console で Places API (New) を有効化して発行
GOOGLE_MAPS_API_KEY=

# --- ジョブ処理 ---
# /api/jobs/process を外部から叩く際の秘密鍵（任意の長いランダム文字列）
JOB_SECRET=
# Vercel Cron が /api/cron/process-jobs を叩く際の秘密鍵（Vercel が Authorization: Bearer で送信）
CRON_SECRET=
# 1回の処理呼び出しで使う最大時間(ms)。Vercel の maxDuration より短くする
JOB_MAX_RUNTIME_MS=50000

# --- クローラー ---
CRAWL_MAX_PAGES=20
CRAWL_DELAY_MS=1000
CRAWL_TIMEOUT_MS=15000
CRAWL_USER_AGENT=AnyWareSalesBot/1.0 (+https://any-ware.jp)
