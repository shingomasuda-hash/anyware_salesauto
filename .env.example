# =============================================================
# AnyWare Sales AI - 環境変数
# .env.local にコピーして値を設定してください（.env.local はコミットしない）
# サーバー専用の値（DATABASE_URL / *_SECRET / *_API_KEY）は絶対に NEXT_PUBLIC_ を付けない
# =============================================================

# --- アプリ ---
# 公開URL（Vercel本番: https://xxx.vercel.app / ローカル: http://localhost:3000）
APP_URL=http://localhost:3000

# 外部API（GビズINFO / Google / Claude）の接続モード
#   live : 実APIを利用（APIキー必須）
#   mock : モックデータを利用（APIキー不要・開発/UI確認用）
# 未設定時: development では mock、production では live
DATA_MODE=mock

# 認証モード
#   supabase 互換の旧設定は廃止。Neon Auth を使用する場合は neon（既定）
#   disabled : 認証をスキップ（development 限定。production では無視されます）
AUTH_MODE=neon

# --- Neon PostgreSQL ---
# Neon Console > Project > Connect から取得（database: neondb）
# 例: postgresql://neondb_owner:xxxx@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Neon Auth ---
# Neon Console > Project > Auth を有効化すると表示される Base URL
# 例: https://ep-xxxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# セッション Cookie 署名用の秘密鍵（32文字以上）。`openssl rand -base64 32` で生成
NEON_AUTH_COOKIE_SECRET=

# --- Anthropic Claude ---
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=
# 使用モデル（コードに直書きしない）
ANTHROPIC_MODEL=claude-opus-5
# 1リクエストの最大出力トークン
ANTHROPIC_MAX_OUTPUT_TOKENS=8000
# AI分析の効率設定 low / medium / high（構造化抽出が中心のため既定は low）
ANTHROPIC_EFFORT=low
# 1回の分析でClaudeへ渡す本文の上限（文字）。入力トークン＝費用に直結する
ANTHROPIC_MAX_CONTEXT_CHARS=10000

# --- AI費用のガード ---
# 当月のClaude API費用の上限（円）。到達するとAI分析を自動で見送る（0で上限なし）
AI_MONTHLY_BUDGET_JPY=10000
# 費用表示・予算判定に使う為替レート（1USD = N円）
AI_USD_JPY_RATE=155
# 採用ページを確認できた企業だけAI分析する（費用の大半はここで決まる）
ANALYSIS_REQUIRE_RECRUIT_PAGE=true

# --- 企業ごとの文面（取材依頼 / サービス提案） ---
# 何を依頼する文面か: interview（取材依頼・既定） / proposal（サービス提案）
SALES_OUTREACH_PURPOSE=interview
# 差出人
SALES_SENDER_COMPANY=
SALES_SENDER_NAME=
# 依頼したい次の行動（未設定なら目的ごとの既定文）
SALES_OUTREACH_CTA=

# 取材依頼: 何について取材したいか（未設定のあいだは文面を生成しません）
SALES_INTERVIEW_TOPIC=
# 取材依頼: 掲載先・媒体
SALES_INTERVIEW_MEDIUM=
# 取材依頼: 形式・所要時間
SALES_INTERVIEW_FORMAT=

# サービス提案（提案内容が決まってから。purpose=proposal のとき必須）
SALES_OFFERING_NAME=
SALES_OFFERING_SUMMARY=
# 強み・提供できること（| 区切り）
SALES_OFFERING_STRENGTHS=

# --- GビズINFO ---
# https://info.gbiz.go.jp/ で API利用申請 → 発行されたトークン
GBIZ_API_KEY=

# --- Google Places API（任意。地域企業の発見・公式サイト探索の補助） ---
GOOGLE_MAPS_API_KEY=

# --- Brave Search API（任意。Web検索での企業発見） ---
# https://brave.com/search/api/ で取得
BRAVE_SEARCH_API_KEY=

# --- EDINET API（任意。上場企業の裏付け） ---
# https://api.edinet-fsa.go.jp/ の利用登録で取得
EDINET_API_KEY=

# --- 企業探索（Multi-Source Discovery） ---
# 使用する情報源
#   hybrid : GビズINFO + Google Places + Web検索 + EDINET（既定・推奨）
#   gbiz   : GビズINFO のみ
#   places : Google Places のみ
#   search : Web検索のみ
DISCOVERY_MODE=hybrid
# 1回の探索で許可する上限（API 料金事故の防止）
DISCOVERY_MAX_PROVIDER_REQUESTS=60
DISCOVERY_MAX_CANDIDATES=600
DISCOVERY_MAX_VERIFICATION_REQUESTS=300
DISCOVERY_MAX_AI_CALLS=200
DISCOVERY_MAX_EXECUTION_MINUTES=60

# --- ジョブ処理 ---
# Vercel Cron が /api/cron/process-jobs を叩く際の秘密鍵（Vercel が Authorization: Bearer で送信）
CRON_SECRET=
# /api/jobs/process を外部スケジューラから叩く際の秘密鍵（任意の長いランダム文字列）
JOB_SECRET=
# 1回の処理呼び出しで使う最大時間(ms)。Vercel の maxDuration より短くする
JOB_MAX_RUNTIME_MS=50000

# --- クローラー ---
CRAWL_MAX_PAGES=20
CRAWL_DELAY_MS=1000
CRAWL_TIMEOUT_MS=15000
CRAWL_USER_AGENT=AnyWareSalesBot/1.0 (+https://any-ware.jp)
